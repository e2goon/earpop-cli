{
  "name": "earpop-cli",
  "version": "0.3.0",
  "description": "Live speech-to-text CLI for the terminal, powered by Soniox",
  "keywords": [
    "asr",
    "cli",
    "ink",
    "realtime",
    "soniox",
    "speech-to-text",
    "stt",
    "terminal",
    "transcription"
  ],
  "license": "MIT",
  "author": "wonmin <e2goon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/e2goon/earpop-cli.git"
  },
  "bin": {
    "earpop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "capture:build": "node scripts/build-capture.mjs",
    "capture:stage": "node scripts/stage-capture.mjs --host",
    "capture:check": "node scripts/publish-capture.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "earpop-capture-darwin-arm64": "workspace:*",
    "earpop-capture-darwin-x64": "workspace:*",
    "earpop-capture-linux-arm64": "workspace:*",
    "earpop-capture-linux-x64": "workspace:*",
    "earpop-capture-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
