{
  "name": "earpop-cli",
  "version": "0.2.1",
  "description": "Live speech-to-text CLI for the terminal, powered by Soniox",
  "keywords": [
    "asr",
    "cli",
    "ink",
    "realtime",
    "soniox",
    "speech-to-text",
    "stt",
    "terminal",
    "transcription"
  ],
  "license": "MIT",
  "author": "wonmin <e2goon@gmail.com>",
  "bin": {
    "earpop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "capture:build": "node scripts/build-capture.mjs",
    "capture:stage": "node scripts/stage-capture.mjs --host",
    "capture:check": "node scripts/publish-capture.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "earpop-capture-darwin-arm64": "workspace:*",
    "earpop-capture-darwin-x64": "workspace:*",
    "earpop-capture-linux-arm64": "workspace:*",
    "earpop-capture-linux-x64": "workspace:*",
    "earpop-capture-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/e2goon/earpop-cli.git"
  }
}
